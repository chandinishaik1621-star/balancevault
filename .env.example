# ==========================================
# BalanceVault Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL in production or local docker:
# DATABASE_URL="postgresql://balance_user:securepassword@localhost:5432/balancevault?schema=public"

# Redis Configuration (Optional - falls back automatically to in-memory store if offline)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_SECRET="balancevault_super_secret_jwt_key_change_in_production_min32chars"
JWT_EXPIRES_IN="24h"

# Admin Bootstrap Secret (Used for initial first-time administrative bootstrapping)
BOOTSTRAP_SECRET="BV_INITIAL_ADMIN_BOOTSTRAP_SECRET_2026"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Client URL (for CORS in separate dev server)
CLIENT_URL="http://localhost:5173"
